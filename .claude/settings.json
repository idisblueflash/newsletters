{
  "permissions": {
    "allow": [
      "Bash(gh api:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rev-parse:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(python3 .claude/skills/beehiiv-seo-metadata/scripts/count_chars.py)",
      "Bash(python3 .claude/skills/beehiiv-seo-metadata/scripts/save_seo.py)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in */articles/*/draft.md) node .claude/skills/beehiiv-draft2html/scripts/draft2html.js \"$f\" ;; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
